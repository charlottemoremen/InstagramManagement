<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <!-- Top Spacer -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="50dp" />

    <!-- Welcome Header -->
    <TextView
        android:id="@+id/welcomeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:fontFamily="@font/inter"
        android:text="Welcome to"
        android:textColor="#633B48"
        android:textSize="20sp" />

    <!-- App Name -->
    <TextView
        android:id="@+id/appNameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:fontFamily="@font/abrilfatface"
        android:text="ScreenSaver"
        android:textColor="#633B48"
        android:textSize="32sp" />

    <TextView
        android:id="@+id/IDText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:fontFamily="@font/inter"
        android:text="A123"
        android:textSize="18sp"
        android:textColor="@color/deep_maroon"
        />

<!--    <View-->
<!--        android:layout_width="400dp"-->
<!--        android:layout_height="2dp"-->
<!--        android:background="#633B48"-->
<!--        android:layout_gravity="center"-->
<!--        android:layout_marginBottom="10dp"-->
<!--        />-->

    <TextView
        android:id="@+id/usageTitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Today's Instagram time:"
        android:textSize="18sp"
        android:textColor="@color/deep_maroon"
        android:fontFamily="@font/inter"
        android:layout_marginBottom="4dp" />

    <!-- Usage Text -->
    <TextView
        android:id="@+id/IGTrackingText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:fontFamily="@font/inter"
        android:text="calculating..."
        android:textColor="#633B48"
        android:textSize="16sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/reportButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="16dp"
        style="@style/RoundedButtonStyle"
        android:text="Generate Report" />


    <!-- Dynamic Spacer -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Image -->
    <ImageView
        android:id="@+id/displayImage"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="90dp"
        android:scaleType="fitXY"
        android:src="@drawable/stripe" />

    <TextView
        android:id="@+id/explainerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_24pt_italic"
        android:text="@string/explain_text"
        android:textColor="#633B48"
        android:padding="16dp"
        android:paddingBottom="20dp"
        android:gravity="center"
        android:textSize="13sp" />
</LinearLayout>
